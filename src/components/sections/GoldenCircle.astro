---
import Container from '../ui/Container.astro';

const circles = [
  {
    id: 'why',
    label: 'WHY',
    sublabel: 'Por qué',
    content: 'Queremos inspirar a una generación que piense globalmente y actúe localmente.',
    bgClass: 'bg-prisma-red',
    textClass: 'text-white',
  },
  {
    id: 'how',
    label: 'HOW',
    sublabel: 'Cómo',
    content: 'Por medio del talento joven ejecutamos proyectos alineados a los ODS con estándares profesionales.',
    bgClass: 'bg-prisma-red-muted',
    textClass: 'text-prisma-red',
  },
  {
    id: 'what',
    label: 'WHAT',
    sublabel: 'Qué',
    content: 'Somos una comunidad de voluntarios enfocados en la formación de jóvenes con visión global y proyectos de impacto social.',
    bgClass: 'bg-prisma-warm',
    textClass: 'text-prisma-gray',
  },
];
---

<section id="golden-circle" class="py-16 lg:py-32 bg-prisma-warm" aria-labelledby="golden-title">
  <Container>
    <div class="text-center max-w-2xl mx-auto mb-10 lg:mb-16">
      <span class="inline-block text-xs font-bold uppercase tracking-[0.2em] text-prisma-red mb-3 lg:mb-4">
        El Círculo Dorado
      </span>
      <h2 id="golden-title" class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight tracking-tight text-prisma-dark">
        ¿Por qué existe Prisma?
      </h2>
    </div>

    <!-- Mobile/Tablet: Cards apiladas -->
    <div class="lg:hidden space-y-4">
      {circles.map((c, i) => (
        <div class={`rounded-2xl p-6 ${c.bgClass}`}>
          <div class="flex items-start gap-4">
            <span class={`text-3xl font-black leading-none ${c.textClass} opacity-30 shrink-0 w-8`}>{i + 1}</span>
            <div>
              <div class="flex items-baseline gap-2 mb-2">
                <span class={`text-xs font-black uppercase tracking-widest ${c.textClass}`}>{c.label}</span>
                <span class={`text-xs ${c.textClass} opacity-60`}>— {c.sublabel}</span>
              </div>
              <p class={`text-sm leading-relaxed ${c.textClass}`}>{c.content}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Desktop: Diagrama + texto -->
    <div class="hidden lg:grid lg:grid-cols-2 gap-16 items-center">
      <!-- Diagrama -->
      <div class="relative flex items-center justify-center">
        <div class="relative w-72 xl:w-80 h-72 xl:h-80" role="img" aria-label="Diagrama del Círculo Dorado">
          <div class="absolute inset-0 rounded-full bg-prisma-warm-dark border-2 border-prisma-border hover:border-prisma-red/30 transition-colors duration-300"></div>
          <div class="absolute inset-12 rounded-full bg-prisma-red-muted border-2 border-prisma-red/20 hover:border-prisma-red/50 transition-colors duration-300"></div>
          <div class="absolute inset-24 rounded-full bg-prisma-red flex items-center justify-center shadow-lg hover:scale-105 transition-transform duration-300"></div>

          <span class="absolute top-5 left-1/2 -translate-x-1/2 text-xs font-black tracking-widest text-prisma-gray uppercase">WHAT</span>
          <span class="absolute top-20 left-1/2 -translate-x-1/2 text-xs font-black tracking-widest text-prisma-red uppercase">HOW</span>
          <div class="absolute inset-24 flex items-center justify-center">
            <span class="text-xs font-black tracking-widest text-white uppercase">WHY</span>
          </div>
        </div>
      </div>

      <!-- Explicaciones -->
      <div class="space-y-6">
        {circles.map((c) => (
          <div class="flex gap-5">
            <div class="shrink-0 mt-1 w-8 h-8 rounded-full flex items-center justify-center" class:list={[c.bgClass]}>
              <span class={`text-xs font-black ${c.textClass}`}>{c.label[0]}</span>
            </div>
            <div>
              <div class="flex items-baseline gap-2 mb-1">
                <span class="text-xs font-black uppercase tracking-widest text-prisma-red">{c.label}</span>
                <span class="text-xs text-prisma-gray-light">— {c.sublabel}</span>
              </div>
              <p class="text-sm text-prisma-gray leading-relaxed">{c.content}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>
