---
import Container from '../ui/Container.astro';

const teamPhoto = "/images/team/team-01.jpg";
const teamPhotoCover = "/images/team/team-cover.jpg";
---

<section id="prisma" class="py-16 lg:py-32 bg-prisma-white" aria-labelledby="welcome-title">
  <Container>

    <!-- Foto panorámica (oculta si no existe) -->
    <div class="mb-12 lg:mb-20 w-full">
      <img
        src={teamPhotoCover}
        alt="Equipo completo de Prisma Global Club"
        class="w-full h-auto max-h-[500px] object-cover object-center"
        loading="lazy"
        onerror="this.parentElement.style.display='none'"
      />
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-start">

      <!-- Texto -->
      <div class="lg:pr-8">
        <span class="inline-block text-[10px] sm:text-xs font-bold uppercase tracking-[0.2em] text-prisma-red mb-4 lg:mb-5">
          Quiénes somos
        </span>
        <h2 id="welcome-title" class="text-4xl sm:text-5xl lg:text-6xl font-black leading-[1.1] tracking-tight text-prisma-dark mb-6 lg:mb-8">
          Una comunidad que transforma desde la acción.
        </h2>
        <div class="space-y-5 text-prisma-gray leading-relaxed text-sm sm:text-base max-w-md">
          <p>
            Prisma Global Club es una organización juvenil que promueve el voluntariado, la formación y el impacto social a través de proyectos sostenibles en comunidades locales.
          </p>
          <p>
            Nace de la convicción de que los jóvenes no solo participan, sino que <strong class="font-semibold text-prisma-dark">lideran cambios reales</strong> cuando cuentan con espacios, guías y alianzas estratégicas.
          </p>
        </div>
      </div>

      <!-- Foto secundaria + palabras clave -->
      <div class="space-y-8 lg:pt-2">
        <!-- Contenedor gris claro para la foto -->
        <div class="rounded-2xl overflow-hidden bg-[#f4f2ef] px-6 py-8 sm:px-12 sm:py-10 flex items-center justify-center">
          <img
            src={teamPhoto}
            alt="Voluntarios de Prisma en actividad"
            class="w-full h-auto object-contain hover:scale-105 transition-transform duration-500 rounded shadow-sm"
            loading="lazy"
            onerror="this.parentElement.style.display='none'"
          />
        </div>

        <div class="grid grid-cols-2 gap-px bg-prisma-border">
          {[
            { word: 'Voluntariado', desc: 'Acción comprometida' },
            { word: 'Formación',   desc: 'Crecimiento continuo' },
            { word: 'Impacto',     desc: 'Resultados medibles' },
            { word: 'Comunidad',   desc: 'Red de líderes' },
          ].map((item) => (
            <div class="bg-prisma-white p-5 sm:p-6 group hover:bg-prisma-red-muted transition-colors duration-200">
              <p class="text-[10px] sm:text-xs font-semibold uppercase tracking-wider text-prisma-gray-light mb-1 group-hover:text-prisma-red transition-colors duration-200">
                {item.desc}
              </p>
              <p class="text-base sm:text-lg font-black text-prisma-dark leading-none">
                {item.word}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Container>
</section>
