---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';

const heroImage: string | null = "/images/hero/hero-team.jpg";
---

<section
  id="inicio"
  class="relative flex flex-col overflow-hidden bg-prisma-white pt-24 lg:pt-28"
  aria-label="Sección principal"
>
  <!-- Fondo decorativo -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute -top-40 -right-40 w-[500px] h-[500px] lg:w-[700px] lg:h-[700px] rounded-full border border-prisma-border opacity-20"></div>
    <div class="absolute -top-20 -right-20 w-[300px] h-[300px] lg:w-[500px] lg:h-[500px] rounded-full border border-prisma-border opacity-20"></div>
  </div>

  <div class="w-full relative z-10 flex-1 flex flex-col">
    <!-- ── Foto panorámica superior ── -->
    <div class="w-full relative max-w-7xl mx-auto lg:px-8">
      {heroImage ? (
        <img
          src={heroImage}
          alt="Equipo Prisma Global Club"
          class="w-full h-[250px] sm:h-[400px] lg:h-[450px] object-cover object-top lg:rounded-2xl lg:shadow-md"
          loading="eager"
          fetchpriority="high"
        />
      ) : (
        <div class="w-full h-72 lg:h-[450px] bg-prisma-warm lg:rounded-2xl flex items-center justify-center" aria-hidden="true">
          <img src="/favicon.png" alt="" class="w-24 h-24 object-contain opacity-20" />
        </div>
      )}
    </div>

    <!-- ── Tarjeta de contenido (superpuesta) ── -->
    <div class="flex flex-col items-center text-center relative z-20 -mt-32 sm:-mt-40 lg:-mt-56 bg-white mx-6 sm:mx-12 lg:mx-auto lg:max-w-xl p-8 sm:p-10 lg:p-10 rounded-t-3xl lg:rounded-3xl shadow-[0_-10px_40px_rgba(0,0,0,0.08)] lg:shadow-[0_20px_50px_rgba(0,0,0,0.15)] mb-16 lg:mb-20">

      <!-- Etiqueta -->
      <span class="text-[10px] sm:text-xs font-bold uppercase tracking-[0.3em] text-prisma-red mb-4 lg:mb-5">
        Bienvenido a
      </span>

      <!-- Favicon + Título -->
      <div class="flex flex-col items-center mb-5 lg:mb-6">
        <img
          src="/favicon.png"
          alt="Logo Prisma Global Club"
          class="w-32 h-32 sm:w-40 sm:h-40 lg:w-40 lg:h-40 object-contain shrink-0 drop-shadow-sm mb-4"
          loading="eager"
          fetchpriority="high"
        />
        <h1 class="font-black leading-[1.05] tracking-tight text-prisma-dark">
          <span class="text-4xl sm:text-5xl lg:text-5xl block">Prisma</span>
          <span class="text-4xl sm:text-5xl lg:text-5xl text-prisma-red block">Global</span>
          <span class="text-4xl sm:text-5xl lg:text-5xl block">Club.</span>
        </h1>
      </div>

      <!-- Mantra -->
      <p class="text-base sm:text-lg font-semibold text-prisma-gray italic mb-3 lg:mb-4 leading-snug mx-auto">
        "Excelencia que transforma realidades."
      </p>

      <!-- Descripción -->
      <p class="text-sm sm:text-base text-prisma-gray leading-relaxed max-w-sm mb-6 lg:mb-8 mx-auto">
        Una comunidad juvenil que convierte el talento, el voluntariado y la colaboración en proyectos capaces de generar impacto real.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row flex-wrap justify-center gap-3 sm:gap-4 w-full sm:w-auto">
        <Button href="#prisma" variant="primary" size="md">
          Conoce Prisma
        </Button>
        <Button href="#cta" variant="secondary" size="md">
          Quiero formar parte
        </Button>
      </div>
    </div>
  </div>
</section>
