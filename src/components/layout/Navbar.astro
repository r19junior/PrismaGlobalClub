---
const navLinks = [
  { label: 'Inicio',        href: '#inicio' },
  { label: 'Prisma',        href: '#prisma' },
  { label: 'Pilares',       href: '#pilares' },
  { label: 'Proyectos',     href: '#proyectos' },
  { label: 'Organización',  href: '#organizacion' },
  { label: 'Alianzas',      href: '#alianzas' },
  { label: 'Beneficios',    href: '#beneficios' },
];

const logoSrc = "/images/logos/prisma-logo.png";
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-prisma-white/95 backdrop-blur-sm"
  role="banner"
>
  <div class="max-w-6xl mx-auto px-5 sm:px-6 lg:px-8">
    <nav class="flex items-center justify-between h-16" aria-label="Navegación principal">

      <!-- Logo -->
      <a href="#inicio" class="flex items-center group shrink-0" aria-label="Prisma Global Club — Inicio">
        <img
          src={logoSrc}
          alt="Prisma Global Club"
          class="h-12 w-auto object-contain group-hover:opacity-80 transition-opacity duration-200"
          loading="eager"
        />
      </a>

      <!-- Links desktop -->
      <ul class="hidden lg:flex items-center gap-5 xl:gap-7" role="list">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm font-medium text-prisma-gray hover:text-prisma-dark transition-colors duration-200 relative group whitespace-nowrap"
            >
              {link.label}
              <span class="absolute -bottom-0.5 left-0 h-px w-0 bg-prisma-red group-hover:w-full transition-all duration-300 ease-out" aria-hidden="true"></span>
            </a>
          </li>
        ))}
      </ul>

      <!-- CTA desktop -->
      <div class="hidden lg:block shrink-0">
        <a
          href="#cta"
          class="inline-flex items-center px-5 py-2.5 text-sm font-semibold bg-prisma-red text-white rounded-full hover:bg-prisma-red-light transition-colors duration-200"
        >
          Únete
        </a>
      </div>

      <!-- Botón hamburguesa móvil -->
      <button
        id="menu-toggle"
        class="lg:hidden flex flex-col gap-1.5 p-2 -mr-2 text-prisma-dark"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú de navegación"
      >
        <span id="bar1" class="block w-5 h-0.5 bg-current transition-all duration-300"></span>
        <span id="bar2" class="block w-5 h-0.5 bg-current transition-all duration-300"></span>
        <span id="bar3" class="block w-5 h-0.5 bg-current transition-all duration-300"></span>
      </button>
    </nav>
  </div>

  <!-- Menú móvil -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden border-t border-prisma-border bg-prisma-white shadow-sm"
    role="dialog"
    aria-label="Menú de navegación"
  >
    <ul class="max-w-6xl mx-auto px-5 py-4 flex flex-col gap-1" role="list">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="mobile-link block py-3 text-sm font-medium text-prisma-gray hover:text-prisma-red border-b border-prisma-border/50 transition-colors duration-200"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="pt-4">
        <a
          href="#cta"
          class="mobile-link inline-flex items-center px-6 py-3 text-sm font-semibold bg-prisma-red text-white rounded-full hover:bg-prisma-red-light transition-colors duration-200"
        >
          Únete
        </a>
      </li>
    </ul>
  </div>
</header>

<div class="h-16" aria-hidden="true"></div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu   = document.getElementById('mobile-menu');
  const bar1   = document.getElementById('bar1');
  const bar2   = document.getElementById('bar2');
  const bar3   = document.getElementById('bar3');
  const navbar = document.getElementById('navbar');
  let isOpen   = false;

  toggle?.addEventListener('click', () => {
    isOpen = !isOpen;
    menu?.classList.toggle('hidden', !isOpen);
    toggle.setAttribute('aria-expanded', String(isOpen));
    bar1?.classList.toggle('rotate-45',    isOpen);
    bar1?.classList.toggle('translate-y-2', isOpen);
    bar2?.classList.toggle('opacity-0',    isOpen);
    bar3?.classList.toggle('-rotate-45',   isOpen);
    bar3?.classList.toggle('-translate-y-2', isOpen);
  });

  document.querySelectorAll('.mobile-link').forEach((link) => {
    link.addEventListener('click', () => {
      isOpen = false;
      menu?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      bar1?.classList.remove('rotate-45', 'translate-y-2');
      bar2?.classList.remove('opacity-0');
      bar3?.classList.remove('-rotate-45', '-translate-y-2');
    });
  });

  window.addEventListener('scroll', () => {
    navbar?.classList.toggle('shadow-sm', window.scrollY > 50);
    navbar?.classList.toggle('border-b', window.scrollY > 50);
    navbar?.classList.toggle('border-prisma-border', window.scrollY > 50);
  }, { passive: true });
</script>
