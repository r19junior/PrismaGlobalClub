---
import Container from '../ui/Container.astro';
import { projects } from '../../data/projects';

const pillarColor: Record<string, string> = {
  'Responsabilidad Ciudadana':         'bg-prisma-red-muted text-prisma-red',
  'Desarrollo e Inclusión Social':      'bg-prisma-warm-dark text-prisma-gray',
  'Patrimonio Cultural y Artístico':    'bg-prisma-dark/10 text-prisma-dark',
};
---

<section id="proyectos" class="py-16 lg:py-32 bg-prisma-warm" aria-labelledby="projects-title">
  <Container>
    <!-- Header -->
    <div class="max-w-2xl mb-10 lg:mb-16">
      <span class="inline-block text-xs font-bold uppercase tracking-[0.2em] text-prisma-red mb-3 lg:mb-4">
        Nuestro trabajo
      </span>
      <h2 id="projects-title" class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight tracking-tight text-prisma-dark mb-4">
        Proyectos que dejan huella.
      </h2>
      <p class="text-prisma-gray leading-relaxed text-sm sm:text-base">
        Acciones concretas en comunidades reales. Cada proyecto es una historia de jóvenes que decidieron actuar.
      </p>
    </div>

    <!-- Grid responsive: 1 col móvil, 2 tablet, 3 desktop -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
      {projects.map((project) => (
        <article class="group flex flex-col bg-prisma-white rounded-2xl overflow-hidden border border-prisma-border hover:border-prisma-red hover:shadow-md transition-all duration-300">

          <!-- Imagen -->
          <div class="relative h-44 sm:h-52 bg-prisma-warm-dark p-2">
            <img
              src={project.image}
              alt={project.title}
              class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
              onerror="this.parentElement.classList.add('flex','items-center','justify-center'); this.style.display='none'; this.parentElement.innerHTML += '<span class=\'text-4xl font-black text-prisma-red-muted select-none opacity-40\'>' + this.alt.charAt(0) + '</span>'"
            />
            <div class="absolute inset-0 bg-prisma-dark/0 group-hover:bg-prisma-dark/10 transition-colors duration-300"></div>
          </div>

          <!-- Contenido -->
          <div class="flex flex-col flex-1 p-5 sm:p-6">
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class={`text-xs font-semibold px-2.5 py-1 rounded-full ${pillarColor[project.pillar] ?? 'bg-prisma-warm text-prisma-gray'}`}>
                {project.category}
              </span>
            </div>

            <h3 class="text-sm sm:text-base font-bold text-prisma-dark leading-tight mb-2">
              {project.title}
            </h3>

            <p class="text-xs sm:text-sm text-prisma-gray leading-relaxed flex-1">
              {project.description}
            </p>

            <div class="mt-4 pt-4 border-t border-prisma-border">
              <span class="text-xs text-prisma-gray-light font-medium leading-tight block">
                {project.pillar}
              </span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </Container>
</section>
