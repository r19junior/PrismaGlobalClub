---
import Container from '../ui/Container.astro';
import BenefitCard from '../cards/BenefitCard.astro';
import { benefits } from '../../data/benefits';
---

<section id="beneficios" class="py-16 lg:py-32 bg-prisma-white" aria-labelledby="benefits-title">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">

      <!-- Header — en mobile va arriba; en desktop sticky -->
      <div class="lg:sticky lg:top-24">
        <span class="inline-block text-xs font-bold uppercase tracking-[0.2em] text-prisma-red mb-3 lg:mb-4">
          Para socios
        </span>
        <h2 id="benefits-title" class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight tracking-tight text-prisma-dark mb-4 lg:mb-6">
          Ser parte también transforma.
        </h2>
        <p class="text-prisma-gray leading-relaxed text-sm sm:text-base max-w-sm">
          Unirte a Prisma no es solo volunteer. Es construir una trayectoria, conectar con líderes y dejar una huella que perdura.
        </p>

        <div class="mt-6 lg:mt-10 grid grid-cols-2 gap-3 sm:gap-4 max-w-xs sm:max-w-sm">
          <div class="p-4 bg-prisma-red-muted rounded-xl">
            <p class="text-xl sm:text-2xl font-black text-prisma-red">3</p>
            <p class="text-xs text-prisma-red/70 font-medium mt-1">Pilares de impacto</p>
          </div>
          <div class="p-4 bg-prisma-warm rounded-xl">
            <p class="text-xl sm:text-2xl font-black text-prisma-dark">ODS</p>
            <p class="text-xs text-prisma-gray font-medium mt-1">Alineados a la ONU</p>
          </div>
        </div>
      </div>

      <!-- Lista de beneficios -->
      <div>
        {benefits.map((benefit) => (
          <BenefitCard {...benefit} />
        ))}
      </div>
    </div>
  </Container>
</section>
