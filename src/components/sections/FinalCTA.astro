---
import Container from '../ui/Container.astro';
---

<section id="cta" class="py-24 lg:py-32 bg-prisma-red" aria-labelledby="cta-title">
  <Container>
    <div class="text-center max-w-2xl mx-auto">
      <span class="inline-block text-xs font-bold uppercase tracking-[0.2em] text-white/60 mb-6">
        Únete a Prisma
      </span>

      <h2 id="cta-title" class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight tracking-tight text-white mb-6">
        El cambio comienza cuando decides ser parte.
      </h2>

      <p class="text-white/70 text-lg leading-relaxed mb-10">
        Conecta con jóvenes, desarrolla tus habilidades y transforma realidades desde la acción.
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="#"
          class="inline-flex items-center px-8 py-4 text-base font-semibold bg-white text-prisma-red rounded-full hover:bg-white/90 transition-colors duration-200"
          aria-label="Quiero formar parte de Prisma Global Club"
        >
          Quiero formar parte
        </a>
        <a
          href="#prisma"
          class="inline-flex items-center px-8 py-4 text-base font-semibold text-white border border-white/40 rounded-full hover:bg-white/10 transition-colors duration-200"
        >
          Conocer más sobre Prisma
        </a>
      </div>

      <p class="mt-16 text-sm italic text-white/40 tracking-wide">
        "Excelencia que transforma realidades"
      </p>
    </div>
  </Container>
</section>
