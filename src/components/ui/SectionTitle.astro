---
interface Props {
  label?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { label, title, subtitle, align = 'left', class: extraClass = '' } = Astro.props;

const alignClass = align === 'center' ? 'text-center mx-auto' : 'text-left';
---

<div class={`max-w-2xl ${alignClass} ${extraClass}`}>
  {label && (
    <span class="inline-block text-xs font-semibold uppercase tracking-[0.15em] text-prisma-red mb-4">
      {label}
    </span>
  )}
  <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight text-prisma-dark">
    {title}
  </h2>
  {subtitle && (
    <p class="mt-4 text-lg text-prisma-gray leading-relaxed">
      {subtitle}
    </p>
  )}
</div>
