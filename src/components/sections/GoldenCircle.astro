---
import Container from '../ui/Container.astro';

const circles = [
  {
    id: 'why',
    label: 'WHY',
    sublabel: 'Por qué',
    content: 'Queremos inspirar a una generación que piense globalmente y actúe localmente.',
    bgClass: 'bg-prisma-red',
    textClass: 'text-white',
    dotClass: 'bg-prisma-red',
    dotText: 'text-white',
  },
  {
    id: 'how',
    label: 'HOW',
    sublabel: 'Cómo',
    content: 'Por medio del talento joven ejecutamos proyectos alineados a los Objetivos de Desarrollo Sostenible (ODS) con estándares profesionales.',
    bgClass: 'bg-prisma-red-muted',
    textClass: 'text-prisma-red',
    dotClass: 'bg-prisma-red-muted',
    dotText: 'text-prisma-red',
  },
  {
    id: 'what',
    label: 'WHAT',
    sublabel: 'Qué',
    content: 'Somos una comunidad de voluntarios enfocados en la formación de jóvenes con visión global y en la ejecución de proyectos de impacto social con estándares globales.',
    bgClass: 'bg-prisma-warm',
    textClass: 'text-prisma-gray',
    dotClass: 'bg-prisma-warm-dark',
    dotText: 'text-prisma-gray',
  },
];
---

<section id="golden-circle" class="py-24 lg:py-32 bg-prisma-warm" aria-labelledby="golden-title">
  <Container>
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="inline-block text-xs font-bold uppercase tracking-[0.2em] text-prisma-red mb-4">
        El Círculo Dorado
      </span>
      <h2 id="golden-title" class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight tracking-tight text-prisma-dark">
        ¿Por qué existe Prisma?
      </h2>
    </div>

    <div class="relative">
      <!-- Vista móvil -->
      <div class="lg:hidden space-y-4">
        {circles.map((c, i) => (
          <div class={`rounded-2xl p-6 ${c.bgClass}`}>
            <div class="flex items-start gap-4">
              <span class={`text-4xl font-black leading-none ${c.textClass} opacity-30 shrink-0`}>{i + 1}</span>
              <div>
                <span class={`text-xs font-black uppercase tracking-widest ${c.textClass} block mb-1`}>{c.label}</span>
                <p class={`text-sm leading-relaxed ${c.textClass}`}>{c.content}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Vista desktop -->
      <div class="hidden lg:grid lg:grid-cols-2 gap-16 items-center">
        <!-- Diagrama -->
        <div class="relative flex items-center justify-center">
          <div class="relative w-80 h-80" role="img" aria-label="Diagrama del Círculo Dorado de Prisma">
            <!-- WHAT (exterior) -->
            <div class="absolute inset-0 rounded-full bg-prisma-warm-dark border-2 border-prisma-border flex items-center justify-center hover:border-prisma-red/30 transition-colors duration-300"></div>
            <!-- HOW (medio) -->
            <div class="absolute inset-12 rounded-full bg-prisma-red-muted border-2 border-prisma-red/20 flex items-center justify-center hover:border-prisma-red/50 transition-colors duration-300"></div>
            <!-- WHY (interior) -->
            <div class="absolute inset-24 rounded-full bg-prisma-red flex items-center justify-center shadow-lg hover:scale-105 transition-transform duration-300"></div>

            <span class="absolute top-6 left-1/2 -translate-x-1/2 text-xs font-black tracking-widest text-prisma-gray uppercase">WHAT</span>
            <span class="absolute top-20 left-1/2 -translate-x-1/2 text-xs font-black tracking-widest text-prisma-red uppercase">HOW</span>
            <div class="absolute inset-24 flex items-center justify-center">
              <span class="text-xs font-black tracking-widest text-white uppercase">WHY</span>
            </div>
          </div>
        </div>

        <!-- Explicaciones -->
        <div class="space-y-6">
          {circles.map((c, i) => (
            <div class="flex gap-5 group">
              <div class="shrink-0 mt-1">
                <div class={`w-8 h-8 rounded-full ${c.dotClass} flex items-center justify-center border ${i === 0 ? 'border-transparent' : 'border-prisma-border'}`}>
                  <span class={`text-xs font-black ${c.dotText}`}>{c.label[0]}</span>
                </div>
              </div>
              <div>
                <div class="flex items-baseline gap-2 mb-1">
                  <span class="text-xs font-black uppercase tracking-widest text-prisma-red">{c.label}</span>
                  <span class="text-xs text-prisma-gray-light">— {c.sublabel}</span>
                </div>
                <p class="text-sm text-prisma-gray leading-relaxed">{c.content}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Container>
</section>
