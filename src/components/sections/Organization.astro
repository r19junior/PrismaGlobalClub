---
import Container from '../ui/Container.astro';
import PersonCard from '../cards/PersonCard.astro';
import { orgChart } from '../../data/organization';
---

<section id="organizacion" class="py-24 lg:py-32 bg-prisma-warm" aria-labelledby="org-title">
  <Container>
    <div class="max-w-xl mb-16">
      <span class="inline-block text-xs font-bold uppercase tracking-[0.2em] text-prisma-red mb-4">
        Estructura
      </span>
      <h2 id="org-title" class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight tracking-tight text-prisma-dark mb-3">
        Las personas detrás de Prisma
      </h2>
      <p class="text-prisma-gray">Una estructura que convierte propósito en acción.</p>
    </div>

    <!-- Organigrama Desktop (Estilo Mapa/Árbol) -->
    <div class="hidden lg:flex flex-col items-center">
      {orgChart.map((level, li) => (
        <div class="flex flex-col items-center w-full">
          <!-- Línea vertical conectora desde el nivel anterior -->
          {li > 0 && (
            <div class="w-px h-10 bg-prisma-dark/40"></div>
          )}

          <!-- Caja del Nivel (Padre) -->
          <div class="border-[1.5px] border-prisma-dark rounded-xl overflow-hidden shadow-sm bg-white text-center w-64 relative z-10">
            <div class="bg-prisma-red/60 text-prisma-dark font-black p-2.5 text-sm uppercase tracking-wide">
              {level.label}
            </div>
          </div>

          <!-- Línea vertical conectora hacia los hijos -->
          <div class="w-px h-8 bg-prisma-dark/40"></div>

          <!-- Hijos (Departamentos) -->
          <div class="flex justify-center relative w-full">
            {level.departments.map((dept, index) => (
              <div class="relative flex flex-col items-center px-4 w-56">
                <!-- Línea horizontal conectora (solo si hay más de 1 hijo) -->
                {level.departments.length > 1 && (
                  <div class="absolute top-0 h-px bg-prisma-dark/40"
                       class:list={[
                         index === 0 ? "left-1/2 right-0" : 
                         index === level.departments.length - 1 ? "left-0 right-1/2" : 
                         "left-0 right-0"
                       ]}>
                  </div>
                )}
                
                <!-- Línea vertical individual hacia la caja -->
                <div class="w-px h-6 bg-prisma-dark/40"></div>
                
                <!-- Caja del Departamento -->
                <div class="border-[1.5px] border-prisma-dark rounded-xl overflow-hidden bg-white text-center w-full shadow-sm">
                   <div class="bg-prisma-red/30 text-prisma-dark font-bold p-2 text-xs uppercase border-b-[1.5px] border-prisma-dark leading-tight h-12 flex items-center justify-center">
                     {dept.name}
                   </div>
                   <div class="p-3 text-sm text-prisma-dark font-medium space-y-1">
                     {dept.members.map((m) => (
                       <div>
                         <span class="block">{m.name}</span>
                         {/* Opcional: mostrar rol en gris <span class="block text-[10px] text-prisma-gray">{m.role}</span> */}
                       </div>
                     ))}
                   </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Organigrama Móvil: Acordeones HTML nativos -->
    <div class="lg:hidden space-y-3">
      {orgChart.map((level) => (
        <details class="group bg-prisma-white rounded-xl border border-prisma-border overflow-hidden">
          <summary class="flex items-center justify-between px-5 py-4 cursor-pointer list-none select-none">
            <div>
              <span class="text-xs font-black uppercase tracking-widest text-prisma-red block mb-0.5">Nivel {level.level}</span>
              <span class="text-sm font-bold text-prisma-dark">{level.label}</span>
            </div>
            <svg
              class="w-4 h-4 text-prisma-gray transition-transform duration-200 group-open:rotate-180"
              viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
            >
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </summary>
          <div class="px-5 pb-4 space-y-4 border-t border-prisma-border">
            {level.departments.map((dept) => (
              <div class="pt-3">
                <p class="text-xs font-bold uppercase tracking-wider text-prisma-gray-light mb-2">{dept.name}</p>
                <div class="space-y-0.5">
                  {dept.members.map((person) => (
                    <PersonCard {...person} />
                  ))}
                </div>
              </div>
            ))}
          </div>
        </details>
      ))}
    </div>
  </Container>
</section>
