---
import Container from '../ui/Container.astro';

const tags = ['Proactiva', 'Curiosa', 'Consciencia social'];

const goals = [
  'Enriquecer su CV con actividades extracurriculares en servicio social.',
  'Incrementar su red de contactos.',
  'Adquirir experiencia real en proyectos.',
  'Participar en organizaciones reconocidas.',
];

const frustrations = [
  'Falta de acción de las autoridades.',
  'Indiferencia colectiva sobre temas sociales y ambientales.',
  'Pocos espacios para conocer personas con propósito.',
];

const interests = [
  'Aportar al cambio con valor trascendental.',
  'Participar en actividades extracurriculares.',
  'Desarrollo personal y profesional.',
];
---

<section id="voluntario" class="py-24 lg:py-32 bg-prisma-white" aria-labelledby="volunteer-title">
  <Container>
    <div class="max-w-xl mb-16">
      <span class="inline-block text-xs font-bold uppercase tracking-[0.2em] text-prisma-red mb-4">
        Perfil del voluntario
      </span>
      <h2 id="volunteer-title" class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight tracking-tight text-prisma-dark">
        ¿Quién forma parte de Prisma?
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-16 items-start">

      <!-- Perfil visual -->
      <div class="lg:col-span-1">
        <img
          src="/images/team/team-02.jpg"
          alt="Priscila Manrique — Voluntaria Prisma Global Club"
          class="w-32 h-32 rounded-full object-cover mb-6 border-4 border-white shadow-sm"
          loading="lazy"
        />

        <h3 class="text-xl font-black text-prisma-dark mb-1">Priscila Manrique</h3>

        <div class="space-y-1 mt-3 mb-6">
          {[
            { label: 'Edad',     value: '20 años' },
            { label: 'Perfil',   value: 'Estudiante' },
            { label: 'Ciudad',   value: 'Arequipa, Perú' },
          ].map((d) => (
            <div class="flex items-center gap-2 text-sm">
              <span class="text-prisma-gray-light w-16 shrink-0">{d.label}</span>
              <span class="text-prisma-dark font-medium">{d.value}</span>
            </div>
          ))}
        </div>

        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="inline-block px-3 py-1 text-xs font-semibold bg-prisma-red-muted text-prisma-red rounded-full">
              {tag}
            </span>
          ))}
        </div>
      </div>

      <!-- Contenido storytelling -->
      <div class="lg:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-8">

        <div>
          <div class="h-0.5 w-8 bg-prisma-red mb-4"></div>
          <h4 class="text-sm font-black uppercase tracking-wider text-prisma-dark mb-4">Sus metas</h4>
          <ul class="space-y-2.5" role="list">
            {goals.map((g) => (
              <li class="flex items-start gap-2.5 text-sm text-prisma-gray leading-relaxed">
                <span class="w-1 h-1 rounded-full bg-prisma-red mt-2 shrink-0" aria-hidden="true"></span>
                {g}
              </li>
            ))}
          </ul>
        </div>

        <div>
          <div class="h-0.5 w-8 bg-prisma-warm-dark mb-4"></div>
          <h4 class="text-sm font-black uppercase tracking-wider text-prisma-dark mb-4">Sus frustraciones</h4>
          <ul class="space-y-2.5" role="list">
            {frustrations.map((f) => (
              <li class="flex items-start gap-2.5 text-sm text-prisma-gray leading-relaxed">
                <span class="w-1 h-1 rounded-full bg-prisma-gray-light mt-2 shrink-0" aria-hidden="true"></span>
                {f}
              </li>
            ))}
          </ul>
        </div>

        <div class="sm:col-span-2">
          <div class="h-0.5 w-8 bg-prisma-red mb-4"></div>
          <h4 class="text-sm font-black uppercase tracking-wider text-prisma-dark mb-4">Sus intereses</h4>
          <div class="flex flex-wrap gap-3">
            {interests.map((i) => (
              <span class="px-4 py-2 text-sm text-prisma-gray bg-prisma-warm rounded-full border border-prisma-border">
                {i}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
